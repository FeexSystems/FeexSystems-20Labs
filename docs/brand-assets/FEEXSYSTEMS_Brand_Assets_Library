```tsx
import React from 'react';

interface EvidenceChipProps {
  sha: string;
  repo: string;
  status?: 'verified' | 'syncing' | 'stale';
  onClick?: () => void;
}

export const EvidenceChip: React.FC<EvidenceChipProps> = ({
  sha,
  repo,
  status = 'verified',
  onClick,
}) => {
  const shortSha = sha.slice(0, 7);

  return (
    <button
      onClick={onClick}
      className="group inline-flex items-center gap-2.5 px-3 py-1 rounded-full bg-[#0A0E17] border border-[#1E293B] hover:border-[#00F5D4]/60 transition-all duration-200 cursor-pointer shadow-sm hover:shadow-feex-hud"
    >
      <span className="relative flex h-2 w-2">
        {status === 'syncing' && (
          <span className="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#00F5D4] opacity-75" />
        )}
        <span
          className={`relative inline-flex rounded-full h-2 w-2 ${
            status === 'verified'
              ? 'bg-[#00F5D4]'
              : status === 'syncing'
              ? 'bg-[#FFB703]'
              : 'bg-[#64748B]'
          }`}
        />
      </span>

      <span className="font-mono text-[10px] font-semibold tracking-wider text-[#64748B] uppercase">
        {repo}
      </span>

      <span className="font-mono text-xs text-[#F8FAFC] font-medium group-hover:text-[#00F5D4] transition-colors">
        sha:{shortSha}
      </span>

      <span className="text-[10px] font-mono px-1.5 py-0.2 rounded bg-[#121826] text-[#00F5D4] border border-[#00F5D4]/20">
        EVIDENCE
      </span>
    </button>
  );
};
```

