// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  passwordHash     String    @map("password_hash")
  firstName        String    @map("first_name")
  lastName         String    @map("last_name")
  profileImageUrl  String?   @map("profile_image_url")
  role             UserRole  @default(USER)
  emailVerified    Boolean   @default(false) @map("email_verified")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  lastLoginAt      DateTime? @map("last_login_at")

  // Relations
  sessions      Session[]
  refreshTokens RefreshToken[]
  subscriptions Subscription[]
  aiRequests    AIRequest[]
  repositories          Repository[]
  securityScans         SecurityScan[]
  recurringSecurityScans RecurringSecurityScan[]
  teamMembers           TeamMember[]
  usageMetrics  UsageMetrics[]
  activityLogs  ActivityLog[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Plan {
  id                String   @id @default(cuid())
  name              String
  description       String?
  stripePriceId     String   @unique @map("stripe_price_id")
  stripeProductId   String   @map("stripe_product_id")
  price             Int      // Price in cents
  currency          String   @default("usd")
  interval          String   // 'month' or 'year'
  intervalCount     Int      @default(1) @map("interval_count")
  trialPeriodDays   Int?     @map("trial_period_days")
  features          Json     // JSON object with feature limits
  isActive          Boolean  @default(true) @map("is_active")
  sortOrder         Int      @default(0) @map("sort_order")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                   String            @id @default(cuid())
  userId               String            @map("user_id")
  planId               String            @map("plan_id")
  status               SubscriptionStatus
  currentPeriodStart   DateTime          @map("current_period_start")
  currentPeriodEnd     DateTime          @map("current_period_end")
  cancelAtPeriodEnd    Boolean           @default(false) @map("cancel_at_period_end")
  stripeSubscriptionId String?           @unique @map("stripe_subscription_id")
  stripeCustomerId     String?           @map("stripe_customer_id")
  trialStart           DateTime?         @map("trial_start")
  trialEnd             DateTime?         @map("trial_end")
  canceledAt           DateTime?         @map("canceled_at")
  endedAt              DateTime?         @map("ended_at")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@map("subscriptions")
}

model AIRequest {
  id             String        @id @default(cuid())
  userId         String        @map("user_id")
  serviceId      String        @map("service_id")
  inputData      Json          @map("input_data")
  outputData     Json?         @map("output_data")
  metadata       Json?
  status         RequestStatus @default(PENDING)
  processingTime Int?          @map("processing_time")
  tokensUsed     Int?          @map("tokens_used")
  createdAt      DateTime      @default(now()) @map("created_at")
  completedAt    DateTime?     @map("completed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ai_requests")
}

model Repository {
  id                   String       @id @default(cuid())
  userId               String       @map("user_id")
  provider             GitProvider
  repoUrl              String       @map("repo_url")
  branch               String       @default("main")
  accessTokenEncrypted String?      @map("access_token_encrypted")
  webhookUrl           String?      @map("webhook_url")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  pipelines   Pipeline[]
  deployments Deployment[]

  @@map("repositories")
}

model Pipeline {
  id           String          @id @default(cuid())
  repositoryId String          @map("repository_id")
  name         String
  stages       Json
  triggers     Json
  environment  Json
  status       PipelineStatus  @default(ACTIVE)
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  repository  Repository   @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  deployments Deployment[]

  @@map("pipelines")
}

model Deployment {
  id           String           @id @default(cuid())
  repositoryId String           @map("repository_id")
  pipelineId   String?          @map("pipeline_id")
  commit       String
  status       DeploymentStatus @default(PENDING)
  logs         Json?
  startedAt    DateTime         @default(now()) @map("started_at")
  completedAt  DateTime?        @map("completed_at")

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  pipeline   Pipeline?  @relation(fields: [pipelineId], references: [id], onDelete: SetNull)

  @@map("deployments")
}

model SecurityScan {
  id          String         @id @default(cuid())
  userId      String         @map("user_id")
  targetData  Json           @map("target_data")
  scanType    SecurityScanType @map("scan_type")
  status      ScanStatus     @default(QUEUED)
  results     Json?
  scheduledAt DateTime?      @map("scheduled_at")
  startedAt   DateTime?      @map("started_at")
  completedAt DateTime?      @map("completed_at")
  createdAt   DateTime       @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("security_scans")
}

model RecurringSecurityScan {
  id             String           @id @default(cuid())
  userId         String           @map("user_id")
  targetData     Json             @map("target_data")
  scanType       SecurityScanType @map("scan_type")
  cronExpression String           @map("cron_expression")
  configuration  Json?
  isActive       Boolean          @default(true) @map("is_active")
  lastRunAt      DateTime?        @map("last_run_at")
  nextRunAt      DateTime?        @map("next_run_at")
  runCount       Int              @default(0) @map("run_count")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("recurring_security_scans")
}

model Team {
  id          String   @id @default(cuid())
  name        String
  description String?
  ownerId     String   @map("owner_id")
  settings    Json?    // Team-wide settings and preferences
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  members         TeamMember[]
  workspaces      Workspace[]
  invitations     TeamInvitation[]
  resourceShares  ResourceShare[]
  activityLogs    TeamActivityLog[]

  @@map("teams")
}

model TeamMember {
  id          String     @id @default(cuid())
  teamId      String     @map("team_id")
  userId      String     @map("user_id")
  role        TeamRole   @default(MEMBER)
  permissions Json?      // Additional granular permissions
  status      MemberStatus @default(ACTIVE)
  joinedAt    DateTime   @default(now()) @map("joined_at")
  invitedBy   String?    @map("invited_by")
  lastActiveAt DateTime? @map("last_active_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@map("team_members")
}

model TeamInvitation {
  id          String           @id @default(cuid())
  teamId      String           @map("team_id")
  email       String
  role        TeamRole         @default(MEMBER)
  permissions Json?            // Additional granular permissions
  status      InvitationStatus @default(PENDING)
  token       String           @unique
  invitedBy   String           @map("invited_by")
  expiresAt   DateTime         @map("expires_at")
  acceptedAt  DateTime?        @map("accepted_at")
  createdAt   DateTime         @default(now()) @map("created_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, email])
  @@map("team_invitations")
}

model Workspace {
  id          String   @id @default(cuid())
  teamId      String   @map("team_id")
  name        String
  description String?
  settings    Json?    // Workspace-specific settings
  isActive    Boolean  @default(true) @map("is_active")
  createdBy   String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  team           Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  resourceShares ResourceShare[]

  @@map("workspaces")
}

model ResourceShare {
  id           String       @id @default(cuid())
  teamId       String       @map("team_id")
  workspaceId  String?      @map("workspace_id")
  resourceType ResourceType @map("resource_type")
  resourceId   String       @map("resource_id")
  permissions  Json         // Specific permissions for this resource
  sharedBy     String       @map("shared_by")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  team      Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([teamId, resourceType, resourceId])
  @@map("resource_shares")
}

model TeamActivityLog {
  id         String   @id @default(cuid())
  teamId     String   @map("team_id")
  userId     String   @map("user_id")
  action     String
  resource   String
  resourceId String   @map("resource_id")
  metadata   Json?
  timestamp  DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, timestamp])
  @@index([action])
  @@index([resource])
  @@map("team_activity_logs")
}

model UsageMetrics {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  period            String
  aiRequestsCount   Int      @default(0) @map("ai_requests_count")
  deploymentCount   Int      @default(0) @map("deployment_count")
  securityScansCount Int     @default(0) @map("security_scans_count")
  storageUsed       BigInt   @default(0) @map("storage_used")
  bandwidthUsed     BigInt   @default(0) @map("bandwidth_used")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, period])
  @@map("usage_metrics")
}

model StripeWebhookEvent {
  id            String   @id @default(cuid())
  stripeEventId String   @unique @map("stripe_event_id")
  eventType     String   @map("event_type")
  processed     Boolean  @default(false)
  data          Json
  createdAt     DateTime @default(now()) @map("created_at")
  processedAt   DateTime? @map("processed_at")

  @@map("stripe_webhook_events")
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  action     String
  resource   String
  resourceId String   @map("resource_id")
  metadata   Json?
  timestamp  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, timestamp])
  @@index([action])
  @@index([resource])
  @@map("activity_logs")
}

// Enums
enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  INCOMPLETE
  INCOMPLETE_EXPIRED
  PAST_DUE
  TRIALING
  UNPAID
  PAUSED
}

enum RequestStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum GitProvider {
  GITHUB
  GITLAB
  BITBUCKET
}

enum PipelineStatus {
  ACTIVE
  PAUSED
  DISABLED
}

enum DeploymentStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  CANCELED
}

enum SecurityScanType {
  VULNERABILITY
  PENETRATION
  COMPLIANCE
}

enum ScanStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum TeamRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

enum ResourceType {
  AI_REQUEST
  REPOSITORY
  PIPELINE
  DEPLOYMENT
  SECURITY_SCAN
  WORKSPACE
}