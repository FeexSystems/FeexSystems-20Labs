// Add ErrorLog model to track errors
model ErrorLog {
  id        String   @id @default(cuid())
  type      String   // ValidationError, AuthenticationError, etc.
  message   String
  stack     String?
  endpoint  String?
  userId    String?
  metadata  Json?    // Additional error context
  timestamp DateTime @default(now())
  severity  String   @default("error") // error, warning, critical

  // Relations
  user User? @relation(fields: [userId], references: [id])

  @@index([timestamp])
  @@index([type])
  @@index([userId])
  @@index([endpoint])
  @@map("error_logs")
}
