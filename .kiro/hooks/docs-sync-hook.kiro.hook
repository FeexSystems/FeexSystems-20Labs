{
  "enabled": true,
  "name": "Documentation Sync",
  "description": "Listens to TypeScript source files and configuration changes to automatically update project documentation",
  "version": "1",
  "when": {
    "type": "fileCreated",
    "patterns": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.js",
      "**/*.jsx",
      "package.json",
      "tsconfig.json",
      "vite.config.ts",
      "tailwind.config.ts",
      "prisma/schema.prisma",
      "docker-compose.yml",
      "netlify.toml"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Source code or configuration files have been modified. Please review the changes and update the project documentation accordingly. Focus on:\n\n1. Update README.md with any new features, setup instructions, or architectural changes\n2. If there's a /docs folder, update relevant documentation files there\n3. Ensure API documentation reflects any endpoint changes\n4. Update setup/installation instructions if dependencies or configuration changed\n5. Document any new environment variables or configuration options\n6. Update architecture diagrams or technical specifications if the system design changed\n\nPlease analyze the specific files that changed and determine what documentation updates are needed to keep everything current and accurate."
  }
}